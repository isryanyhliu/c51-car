\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 超声波测距模块精度标定实验。\textbf  {(a)} 8个标准距离下的测量值与理想值对比， 测量值始终略高于实际值（系统偏差$+1.2\%$--$+1.7\%$），主要来源于11.0592MHz晶振的补偿残差； \textbf  {(b)} 绝对误差与相对误差分布，最大绝对误差$+42$mm出现在3m处，相对误差整体稳定在1\%--2\%区间。}}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig:ultrasonic_accuracy}{{2}{10}{超声波测距模块精度标定实验。\textbf {(a)} 8个标准距离下的测量值与理想值对比， 测量值始终略高于实际值（系统偏差$+1.2\%$--$+1.7\%$），主要来源于11.0592MHz晶振的补偿残差； \textbf {(b)} 绝对误差与相对误差分布，最大绝对误差$+42$mm出现在3m处，相对误差整体稳定在1\%--2\%区间。}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 红外避障模块在不同颜色物体下的最大检测距离。白色物体检测距离28.5cm， 而黑色物体仅9.7cm（下降66\%），透明物体完全不触发。 该特性与超声波形成互补：超声波对黑色物体的检测不受影响。}}{10}{figure.caption.5}\protected@file@percent }
\newlabel{fig:ir_color}{{3}{10}{红外避障模块在不同颜色物体下的最大检测距离。白色物体检测距离28.5cm， 而黑色物体仅9.7cm（下降66\%），透明物体完全不触发。 该特性与超声波形成互补：超声波对黑色物体的检测不受影响。}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 三种避障方案在4类场景下的成功率对比（每组$n=30$）。 场景B（软质海绵）中纯超声波方案骤降至43.3\%，因为海绵多孔结构吸收了超声波能量； 本文融合方案保持96.7\%的高成功率（得益于红外传感器对近距海绵仍有~65\%的检出率）。 场景D（同时循迹+避障）仅融合方案可实现（83.3\%）。}}{11}{figure.caption.6}\protected@file@percent }
\newlabel{fig:strategy_comparison}{{4}{11}{三种避障方案在4类场景下的成功率对比（每组$n=30$）。 场景B（软质海绵）中纯超声波方案骤降至43.3\%，因为海绵多孔结构吸收了超声波能量； 本文融合方案保持96.7\%的高成功率（得益于红外传感器对近距海绵仍有~65\%的检出率）。 场景D（同时循迹+避障）仅融合方案可实现（83.3\%）。}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 系统6轮迭代优化的性能变化轨迹。v1（硬件PWM）将CPU占用率从98\%降至3\%， 是后续所有多传感器并行处理的前提；v4（协同融合）实现了检出率的跳跃式提升（+43\%相对于超声波单传感器场景B）。 v5（自适应阈值）进一步将平均响应时间压缩至127ms。}}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:optimization}{{5}{11}{系统6轮迭代优化的性能变化轨迹。v1（硬件PWM）将CPU占用率从98\%降至3\%， 是后续所有多传感器并行处理的前提；v4（协同融合）实现了检出率的跳跃式提升（+43\%相对于超声波单传感器场景B）。 v5（自适应阈值）进一步将平均响应时间压缩至127ms。}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 软件PWM与定时器PWM的调速线性度对比。定时器PWM方案在线性度（$R^2=0.992$ vs $R^2=0.936$） 与速度稳定性（灰色区域宽度对应$\pm 1\sigma $波动范围）上均显著优于软件PWM。}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:pwm_curve}{{6}{12}{软件PWM与定时器PWM的调速线性度对比。定时器PWM方案在线性度（$R^2=0.992$ vs $R^2=0.936$） 与速度稳定性（灰色区域宽度对应$\pm 1\sigma $波动范围）上均显著优于软件PWM。}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 多传感器融合感知覆盖雷达图。6种典型障碍物类型下， 纯超声波与纯红外各有明显"感知盲区"（雷达图上凹入区域）； 本文融合方案通过置信度加权实现了全方位的感知覆盖，各方向上检出率均超过78\%。}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:fusion_radar}{{7}{12}{多传感器融合感知覆盖雷达图。6种典型障碍物类型下， 纯超声波与纯红外各有明显"感知盲区"（雷达图上凹入区域）； 本文融合方案通过置信度加权实现了全方位的感知覆盖，各方向上检出率均超过78\%。}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces 三级优先级仲裁决策流程。红外传感器（响应$\sim $8.5ms）在近距离场景拥有更高决策优先级， 超声波（响应$\sim $127ms）负责中远距离预判。该分层机制避免了多传感器指令冲突。}}{13}{figure.caption.10}\protected@file@percent }
\newlabel{fig:arbitration}{{8}{13}{三级优先级仲裁决策流程。红外传感器（响应$\sim $8.5ms）在近距离场景拥有更高决策优先级， 超声波（响应$\sim $127ms）负责中远距离预判。该分层机制避免了多传感器指令冲突。}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces 超声波回波时间与距离的线性拟合。$R^2 = 0.9997$验证了 $d = \alpha \cdot T + \beta $线性模型的高度适切性（$\alpha \approx 0.170$，与理论值0.170mm/$\mu $s高度吻合）。}}{14}{figure.caption.11}\protected@file@percent }
\newlabel{fig:echo_fit}{{9}{14}{超声波回波时间与距离的线性拟合。$R^2 = 0.9997$验证了 $d = \alpha \cdot T + \beta $线性模型的高度适切性（$\alpha \approx 0.170$，与理论值0.170mm/$\mu $s高度吻合）。}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces 5点滑动窗口中值滤波效果。原始信号中存在3处偶发性异常 （第10采样点：320mm，第25采样点：680mm，第40采样点：280mm）， 中值滤波完全消除了这些脉冲噪声，输出保持稳定在500mm附近。}}{14}{figure.caption.12}\protected@file@percent }
\newlabel{fig:median_filter}{{10}{14}{5点滑动窗口中值滤波效果。原始信号中存在3处偶发性异常 （第10采样点：320mm，第25采样点：680mm，第40采样点：280mm）， 中值滤波完全消除了这些脉冲噪声，输出保持稳定在500mm附近。}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces 三种传感器的平均响应时间对比。红外类传感器（避障8.5ms，循迹6.2ms） 比超声波（127ms）快约15--20倍，这为优先级仲裁机制中将红外置于更高级别提供了实验依据。}}{15}{figure.caption.13}\protected@file@percent }
\newlabel{fig:response_time}{{11}{15}{三种传感器的平均响应时间对比。红外类传感器（避障8.5ms，循迹6.2ms） 比超声波（127ms）快约15--20倍，这为优先级仲裁机制中将红外置于更高级别提供了实验依据。}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces 循迹控制分析。\textbf  {(a)} 有限状态机状态转移模型，4个状态对应4种传感器读数组合； \textbf  {(b)} 差速比$\beta $对循迹性能的影响，$\beta =2.0$时弯道通过率达94.3\%且摆动幅度最小（1.4cm）， 验证了该参数的帕累托最优性。}}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:tracking_analysis}{{12}{15}{循迹控制分析。\textbf {(a)} 有限状态机状态转移模型，4个状态对应4种传感器读数组合； \textbf {(b)} 差速比$\beta $对循迹性能的影响，$\beta =2.0$时弯道通过率达94.3\%且摆动幅度最小（1.4cm）， 验证了该参数的帕累托最优性。}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces 三级距离分级避障响应策略。$d>300$mm全速巡航，$150<d\leq 300$mm减速慢行（PWM降至80）， $d\leq 150$mm紧急规避。三级分级使避障行为更平滑，避免了单阈值方案在临界距离处的"抖动决策"。}}{15}{figure.caption.15}\protected@file@percent }
\newlabel{fig:distance_zones}{{13}{15}{三级距离分级避障响应策略。$d>300$mm全速巡航，$150<d\leq 300$mm减速慢行（PWM降至80）， $d\leq 150$mm紧急规避。三级分级使避障行为更平滑，避免了单阈值方案在临界距离处的"抖动决策"。}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces 多传感器场景置信度矩阵——式(\ref {eq:confidence})的实验标定数据。 各场景下置信度最高的传感器被赋予最大融合权重。 该矩阵是传感器从"各自为政"走向"协同感知"的核心数据基础。}}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:confidence}{{14}{16}{多传感器场景置信度矩阵——式(\ref {eq:confidence})的实验标定数据。 各场景下置信度最高的传感器被赋予最大融合权重。 该矩阵是传感器从"各自为政"走向"协同感知"的核心数据基础。}{figure.caption.16}{}}
